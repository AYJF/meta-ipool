echo "devtype: ${devtype}"
echo "devnum: ${devnum}"
echo "distro_bootpart: ${distro_bootpart}"

test -n "${BOOT_ORDER}" || env set BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || env set BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || env set BOOT_B_LEFT 3
test -n "${RAUC_BOOTDEV}" || env set RAUC_BOOTDEV "${devtype} ${devnum}:${distro_bootpart}"

env set RAUC_BOOTPART
env set RAUC_SLOT

echo "BOOT_ORDER: ${BOOT_ORDER}"
for RAUC_BOOTSLOT in "${BOOT_ORDER}"; do
  if test "x${RAUC_BOOTPART}" != "x"; then
    # slot already chosen; skip the rest
  elif test "x${RAUC_BOOTSLOT}" = "xA"; then
    if test ${BOOT_A_LEFT} -gt 0; then
      echo "using RAUC slot A (tries left: ${BOOT_A_LEFT})"
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      env set RAUC_BOOTPART "PARTLABEL=rootfsA"
      env set RAUC_SLOT "A"
      env set RAUC_BOOTDEV "${devtype} ${devnum}:${distro_bootpart}"
    fi
  elif test "x${RAUC_BOOTSLOT}" = "xB"; then
    if test ${BOOT_B_LEFT} -gt 0; then
      echo "using RAUC slot B (tries left: ${BOOT_B_LEFT})"
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      env set RAUC_BOOTPART "PARTLABEL=rootfsB"
      env set RAUC_SLOT "B"
      setexpr BOOTPART1 ${distro_bootpart} + 1
      env set RAUC_BOOTDEV "${devtype} ${devnum}:${BOOTPART1}"
    fi
  fi
done

if test -n "${RAUC_BOOTPART}"; then
  env set bootargs "${bootargsbase} root=${RAUC_BOOTPART} rauc.slot=${RAUC_SLOT}"
  env save
else
  echo "No valid RAUC slot found. Resetting tries to 3 and rebooting"
  env set BOOT_A_LEFT 3
  env set BOOT_B_LEFT 3
  env save
  reset
fi

echo "RAUC_BOOTDEV: ${RAUC_BOOTDEV}  slot: ${RAUC_SLOT}"

# iPool SZ3568 boots a PLAIN arm64 Image (not a FIT), so load the kernel and the
# device tree separately from the selected rootfs slot's /boot, then booti.
# (The stock rk-rauc-demo boot.cmd does `bootm`, which only works for a FIT.)
ext4load ${RAUC_BOOTDEV} ${kernel_addr_r} @@KERNEL_BOOTFILE@@
ext4load ${RAUC_BOOTDEV} ${fdt_addr_r} /boot/rk3568-sz3568-linux.dtb

# Force OUR bootargs into the loaded FDT's /chosen. The vendor DTB ships a
# baked-in /chosen/bootargs (console=ttyFIQ0 on the unexposed uart2 +
# root=PARTUUID=614e0000-0000 placeholder). Without this, the kernel uses those
# instead of the RAUC slot args set above -> silent console + no root -> hang,
# no display. Also pin an explicit earlycon on uart8 (0xfe6c0000) so early
# kernel output is guaranteed on the board's UART3/ttyS8 header.
setenv bootargs "earlycon=uart8250,mmio32,0xfe6c0000 ${bootargs}"
fdt addr ${fdt_addr_r}
fdt set /chosen bootargs "${bootargs}"

booti ${kernel_addr_r} - ${fdt_addr_r}

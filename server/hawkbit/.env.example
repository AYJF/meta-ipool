# Copy to .env on the server and fill in. NEVER commit .env.
HAWKBIT_DOMAIN=updates.example.com
ACME_EMAIL=ajimenez@qeiinc.com

# Pin a real tag once you have confirmed it on Docker Hub. "latest" is convenient
# for a pilot but means an unattended image change can break your fleet's server.
HAWKBIT_TAG=latest


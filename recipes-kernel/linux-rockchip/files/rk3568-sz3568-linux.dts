#include "rk3568-sz3568-v10.dtsi"
#include "rk3568-linux.dtsi"
#include <dt-bindings/display/rockchip_vop.h>

/ {
        panel {
                compatible = "simple-panel";
                backlight = <&backlight>;
                power-supply = <&vcc3v3_lcd1_n>;
                enable-delay-ms = <20>;
                prepare-delay-ms = <20>;
                unprepare-delay-ms = <20>;
                disable-delay-ms = <20>;
                //bus-format = <MEDIA_BUS_FMT_RGB666_1X7X3_SPWG>;
                width-mm = <217>;
                height-mm = <136>;
        	status = "okay";

                disp_timings2: display-timings {
                        native-mode = <&timing0>;

                        timing0: timing0 {
                                /* iPool 7" XXR070B4120, 1024x600 single-ch LVDS.
                                 * Exact values from the vendor's WORKING shipped
                                 * DTB (sz3568_..._lvds_1024x600 image). */
                                clock-frequency = <66000000>;
                                hactive = <1024>;
                                vactive = <600>;
                                hback-porch = <200>;
                                hfront-porch = <110>;
                                vback-porch = <20>;
                                vfront-porch = <13>;
                                hsync-len = <10>;
                                vsync-len = <2>;
                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <0>;
                        };
                };

                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;

			/* Single-channel LVDS: panel <-> &lvds (LVDS0) only.
			 * (Vendor working 1024x600 build is single-channel; the
			 * dual-lvds odd/even split was for their 1920x1080 panel.) */
			port@0 {
				reg = <0>;
				panel_in_lvds0: endpoint {
					remote-endpoint = <&lvds0_out_panel>;
				};
			};
                };
        };
        edp-panel {
                compatible = "simple-panel";
                backlight = <&backlight>;
                power-supply = <&vcc3v3_lcd0_n>;
                prepare-delay-ms = <120>;
                enable-delay-ms = <120>;
                unprepare-delay-ms = <120>;
                disable-delay-ms = <120>;
        	status = "disabled";

                display-timings {
                        native-mode = <&edp_timing>;

                        edp_timing: timing0 {
                                clock-frequency = <120000000>;
                                hactive = <1920>;
                                vactive = <1080>;
                                hfront-porch = <12>;
                                hsync-len = <16>;
                                hback-porch = <48>;
                                vfront-porch = <8>;
                                vsync-len = <4>;
                                vback-porch = <8>;
                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <0>;
                        };
                };

                port {
                        panel_in_edp: endpoint {
                                remote-endpoint = <&edp_out_panel>;
                        };
                };
        };
};

&rng {
        status = "okay";
};

&rockchip_suspend {
        status = "disabled";
};

&vop {
        support-multi-area;
};

&uart0 {
        status = "okay";
};
/*
&uart1 {
        pinctrl-names = "default";
        pinctrl-0 = <&uart1m1_xfer>;
        status = "okay";
};*/

&uart5 {
        pinctrl-names = "default";
        pinctrl-0 = <&uart5m1_xfer>;
        status = "okay";
};

&uart7 {
        pinctrl-names = "default";
        pinctrl-0 = <&uart7m2_xfer>;
        status = "okay";
};

&uart8 {
        pinctrl-names = "default";
        /* iPool bench: the UART3/ttyS8 header on this board is wired to the uart8
         * M0 pin group (that is where serial output actually appears). The vendor
         * DTS used uart8m1_xfer which routes ttyS8 to the M1 pins -> no output on
         * our header. Use m0 to match the physical console connection. */
        pinctrl-0 = <&uart8m0_xfer>;
        status = "okay";
};

&uart9 {
        pinctrl-names = "default";
        pinctrl-0 = <&uart9m2_xfer>;
        status = "okay";
};


&i2c0 {
        status = "okay";
         rtc@51 {
                compatible = "rtc,hym8563";
                reg = <0x51>;
                //irq_gpio = <&gpio4 25 IRQ_TYPE_EDGE_FALLING>;
        };

};

&i2c1 {
        status = "okay";

        gt9xxx: gt9xx@14 {
                compatible = "goodix,gt9xx";
                reg = <0x14>;
                //touch-gpio = <&gpio1 9 IRQ_TYPE_LEVEL_LOW>;
                //reset-gpio = <&gpio1 10 GPIO_ACTIVE_HIGH>;
                touch-gpio = <&gpio0 13 IRQ_TYPE_LEVEL_LOW>;
                reset-gpio = <&gpio0 14 GPIO_ACTIVE_HIGH>;
                max-x = <1536>;
                max-y = <2048>;
                tp-size = <970>;
                status = "okay";

        };

    gt911: gt911@14 {
                compatible = "goodix,gt9xx";
                reg = <0x14>;
                touch-gpio = <&gpio0 5 IRQ_TYPE_LEVEL_LOW>;
                reset-gpio = <&gpio0 12 GPIO_ACTIVE_HIGH>;
                max-x = <1280>;
                max-y = <800>;
                tp-size = <911>;
                status = "disabled";
        };
};

&i2c2 {
    status = "okay";
    /* i2c mux investigation CLOSED: m1 (GPIO4_B5/B4) = clean bus, 0 devices;
     * m0 (GPIO0_B5/B6) = continuous "rk3x-i2c fe5b0000.i2c: timeout state 2"
     * (bus stuck, floods log, delays boot to 40s). The GM8775C is on NEITHER --
     * it is not an i2c slave on this board (strap-configured). Keep m1 (clean). */
    pinctrl-0 = <&i2c2m1_xfer>;
        // tc_bridge: bridge@0f {

        //      compatible = "toshiba,tc358775";
        //      reg = <0x0f>;
        //      vdd-supply = <&vcc1v2_tc358775>;
        //      // vddio-supply = <&vcc1v2_tc358775>;
        //      // stby-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
        //      reset-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
        //      ports {
        //              #address-cells = <1>;
        //              #size-cells = <0>;
        //              port@0 {
        //                      reg = <0>;
        //                      d2l_in_test: endpoint {
        //                              remote-endpoint = <&dsi0_out>;
        //                      };
        //              };
        //              port@1 {
        //                      reg = <1>;
        //                      lvds_out: endpoint {
        //                              remote-endpoint = <&panel_in>;
        //                      };
        //              };
        //      };
        // };

        /* Bridge chips DISABLED: this board drives the panel via the SoC's
         * native LVDS (see DISPLAY block below), so neither the TC358775 nor
         * the GM8775C is in the display path. Left here (disabled) only to
         * document the vendor's populated-but-unused footprints; keeping them
         * "okay" just made the tc358775 driver probe a non-responding i2c slave. */
        tc8775: tc8775@0f {
        compatible ="toshiba,tc358775";
        reg=<0x0f>;
        status="disabled";
    };
        gm8775c@2c {
                               compatible = "gm8775c,mipi_to_lvds";
                               reg = <0x2c>;
                               status = "disabled";
               };

};

&i2c3 {
        status = "okay";

     /*  gt9xxx: gt9xx@14 {
                compatible = "goodix,gt9xx";
                reg = <0x14>;
               // touch-gpio = <&gpio1 9 IRQ_TYPE_LEVEL_LOW>;
               // reset-gpio = <&gpio1 10 GPIO_ACTIVE_HIGH>;
                touch-gpio = <&gpio0 13 IRQ_TYPE_LEVEL_LOW>;
                reset-gpio = <&gpio0 14 GPIO_ACTIVE_HIGH>;
                max-x = <1536>;
                max-y = <2048>;
                tp-size = <970>;
                status = "okay";

        };*/
};


&backlight {
        status = "okay";
        enable-gpios = <&gpio0 29 0>;
        power-supply = <&vcc3v3_lcd0_n>;
        post-pwm-on-delay-ms = <100>;
        pwm-off-delay-ms = <10>;

};

&backlight1 {
        enable-gpios = <&gpio0 28 0>;
        power-supply = <&vcc3v3_lcd1_n>;
        post-pwm-on-delay-ms = <100>;
        pwm-off-delay-ms = <10>;
        status = "okay";
};


&dsi0 {
        status = "disabled";
};

&dsi0_in_vp0 {
        status = "disabled";
};

&dsi0_in_vp1 {
        status = "disabled";
};

&video_phy0 {
        status = "okay";
};

&dsi1 {
        enable-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
        tc3587_res-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
        tc3587-res-gpios-sw = "on";
        power-supply = <&vcc1v2_tc358775>;
        rockchip,lane-rate = <900>;
        status = "disabled";
};

&dsi1_in_vp0 {
        status = "disabled";
};

&dsi1_in_vp1 {
        status = "okay";
};

&video_phy1 {
        status = "okay";
};

&edp {
        force-hpd;
        status = "disabled";

        ports {
                port@1 {
                        reg = <1>;

                        edp_out_panel: endpoint {
                                remote-endpoint = <&panel_in_edp>;
                        };
                };
        };
};

&edp_phy {
        status = "okay";
};

&edp_in_vp0 {
        status = "disabled";
};

&edp_in_vp1 {
        status = "okay";
};
&route_edp {
        connect = <&vp1_out_edp>;
        status = "okay";
};

&lvds {
        status = "disabled";
	dual-channel;

        ports {
                port@1 {
                        reg = <1>;

                        lvds0_out_panel: endpoint {
                                remote-endpoint = <&panel_in_lvds0>;
                        };
                };
        };

};

&lvds1 {
	status = "disabled";

	ports {
		port@1 {
			reg = <1>;
			lvds1_out_panel: endpoint {
				remote-endpoint = <&panel_in_lvds1>;
			};
		};
	};
};

&lvds_in_vp1 {
        status = "okay";
};

&lvds_in_vp2 {
        status = "disabled";
};
&route_lvds {
        status = "okay";
        connect = <&vp1_out_lvds>;
};

&dmc {
        status = "disabled";
        auto-freq-en = <0>;
};

&hdmi {
        status = "okay";
};

&route_hdmi{
        status = "okay";
};

&hdmi_sound {
        status = "okay";
};

&vp1{
        rockchip,plane-mask = <(1<< ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_ESMART0 | 1 << ROCKCHIP_VOP2_SMART0)>;
        rockchip,primary-plane = <ROCKCHIP_VOP2_SMART0>;
};

&vp0{
        rockchip,plane-mask = <(1<< ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_ESMART1 | 1 << ROCKCHIP_VOP2_SMART1)>;
        rockchip,primary-plane = <ROCKCHIP_VOP2_SMART1>;
};
/*
&vp0 {
        cursor-win-id = <ROCKCHIP_VOP2_CLUSTER0>;
};

&vp1 {
        cursor-win-id = <ROCKCHIP_VOP2_CLUSTER1>;
};*/

/*
 * iPool: disable USB2 host1 (EHCI fd880000 + OHCI fd8c0000). Its downstream
 * port is unpopulated (the board's 4G/USB slot) and floats, so the hub driver
 * spins in a tight retry loop spamming "usb5-port1: config error / Cannot
 * enable. Maybe the USB cable is bad?" -- this floods the synchronous ttyS8
 * console and starves the boot before userspace/Boot2Qt. Nothing we need is on
 * host1 (touchscreen is on host0 fd800000; WiFi AIC8800 is on SDIO sdmmc1), so
 * turn it off. Re-enable if the 4G/USB port is ever populated.
 */
&usb_host1_ehci {
	status = "disabled";
};

&usb_host1_ohci {
	status = "disabled";
};

/* ==========================================================================
 * WiFi (SDIO / sdmmc1): ENABLED -- RTL8723DS.
 *
 * The board's WiFi is RTL8723DS (confirmed: the vendor's own working sz3568
 * image DTB declares wifi_chip_type="rtl8723ds" and ships 8723ds.ko; the
 * "aic8800" string in rk3568-sz3568.dtsi is a variant/template leftover).
 * We override it to rtl8723ds below and install the matching driver.
 *
 * No pin conflict with our uart8m0 serial console: sdmmc1 uses GPIO2_A3..B0,
 * uart8m0 uses GPIO2_C5/C6, and sdio_pwrseq takes its 32 kHz from the rk809
 * PMIC (not a wifi_32k GPIO). Bluetooth stays DISABLED -- BT is on uart8,
 * which we use for the console; WiFi is on SDIO and doesn't touch uart8. Turn
 * BT on later only if the console is moved off uart8.
 * ========================================================================== */
&sdio_pwrseq  {
	status = "okay";
	/* Drop wifi_32k from the pinmux: v10.dtsi muxes it to GPIO2_C6, which is
	 * our uart8m0 serial-console pin, so the pwrseq fails to claim it
	 * ("pin gpio2-22 already requested by fe6c0000.serial ... Error applying
	 * setting"), which then aborts the WiFi power-on and no SDIO card / wlan0
	 * appears. wifi_32k is only the 32.768kHz WiFi sleep clock; RTL8723DS
	 * associates fine without it (loses only deep-sleep power saving). Keep
	 * just wifi_enable_h so the chip still gets powered/reset. */
	pinctrl-0 = <&wifi_enable_h>;
};
&sdmmc1       { status = "okay"; };
&wireless_wlan {
	status = "okay";
	wifi_chip_type = "rtl8723ds";
};
&wireless_bluetooth { status = "disabled"; };

/* ==========================================================================
 * MINIMAL BRING-UP: disable all heavy/optional (power-domain-backed) blocks so
 * the board boots clean to a serial login. Re-enable groups one at a time to
 * bring hardware back (display + DSI->LVDS bridge last). WiFi/BT + sdio_pwrseq
 * are disabled above (they also free uart8 RX). eMMC/PMIC/uart8/i2c/gmac kept.
 * ========================================================================== */

/* GPU: ENABLED for the PROPRIETARY Mali Bifrost driver (built into the kernel)
 * + libmali userspace -- the vendor's proven stack (their shipped image runs
 * exactly this). Unlike panfrost (which hard-hangs on GPU power-on here), the
 * proprietary driver brings the GPU power domain up correctly, so we KEEP the
 * vendor OPP table (the proprietary driver's DVFS parses it fine -- it was only
 * panfrost's generic OPP parser that choked on it). DDR freq scaling stays off. */
&gpu { status = "okay"; };
&dmc { status = "disabled"; };

/* Media Process Platform (video codecs) */
&rkvdec { status = "disabled"; };
&rkvenc { status = "disabled"; };
&vdpu   { status = "disabled"; };
&vepu   { status = "disabled"; };
&iep    { status = "disabled"; };
&jpegd  { status = "disabled"; };
&rknpu  { status = "disabled"; };

/* Display pipeline (headless bring-up; re-added with the panel later) */
/* HDMI RE-ENABLED: VOP2 + HDMI on VP0 give a display + a console on the HDMI
 * screen (fbcon on tty1). With a USB keyboard this is a local shell that
 * bypasses the broken serial RX. Bridge-independent; GPU stays off (fbcon needs
 * only VOP2, not Mali). */
&vop        { status = "disabled"; };
&hdmi       { status = "disabled"; };
&hdmi_sound { status = "disabled"; };
&dsi0       { status = "disabled"; };
&dsi1       { status = "disabled"; };
&edp        { status = "disabled"; };
&lvds       { status = "disabled"; };
&lvds1      { status = "disabled"; };
&video_phy0 { status = "disabled"; };
&video_phy1 { status = "disabled"; };

/* Cameras / ISP */
&csi2_dphy0   { status = "disabled"; };
&csi2_dphy_hw { status = "disabled"; };
&mipi_csi2    { status = "disabled"; };
&rkcif        { status = "disabled"; };
&rkcif_mmu    { status = "disabled"; };
&rkisp        { status = "disabled"; };
&rkisp_mmu    { status = "disabled"; };

/* Audio */
&rk809_sound { status = "disabled"; };
&i2s0_8ch    { status = "disabled"; };
&i2s1_8ch    { status = "disabled"; };

/* PCIe */
&pcie2x1   { status = "disabled"; };
&pcie3x2   { status = "disabled"; };
&pcie30phy { status = "disabled"; };

/* ==========================================================================
 * DISPLAY: VOP2 (VP1) -> NATIVE RK3568 LVDS (&lvds) -> simple-panel (1024x600).
 *
 * THE VENDOR'S ACTUAL WORKING PATH, confirmed by decompiling the DTB out of
 * their shipped sz3568_Ubuntu1804_..._lvds_1024x600 firmware image: the panel is
 * a plain root-level "simple-panel" driven by the SoC's built-in LVDS TX -- NOT
 * DSI and NOT the GM8775C bridge. In the working DTB dsi@fe060000 and
 * dsi@fe070000 are BOTH disabled, and gm8775c@2c / tc8775@0f merely probe on i2c2
 * (vestigial -- they drive nothing). Hence the entire i2c / DSI-command-mode
 * bridge-config effort was chasing a pipeline this board doesn't use.
 *
 * Single-channel, 24-bit; LVDS output format = rk3568-lvds driver default (the
 * vendor DTB sets no bus-format/data-mapping). The vendor body above already has
 * &lvds_in_vp1 = okay and &route_lvds = okay (connect <&vp1_out_lvds>), and
 * &lvds port@1 (lvds0_out_panel) -> panel port@0 (panel_in_lvds0). Here we just
 * enable &vop + &lvds (single channel) and keep the DSI/bridge path OFF so it
 * cannot steal VP1.
 * ========================================================================== */
&vop         { status = "okay"; };
&video_phy0  { status = "okay"; };

&lvds {
	status = "okay";
	/delete-property/ dual-channel;   /* single-channel for the 1024x600 panel */
};

/* DSI/bridge path stays OFF (dsi0 on VP1 would collide with LVDS on VP1). */
&dsi0 { status = "disabled"; };
&dsi1 { status = "disabled"; };

/* We converted the panel to a single LVDS port (dropped port@1/panel_in_lvds1),
 * so the &lvds1 output endpoint's remote-endpoint now dangles. Drop it (lvds1
 * stays disabled) to keep the phandle graph valid. */
&lvds1_out_panel {
	/delete-property/ remote-endpoint;
};


/* ==========================================================================
 * Ethernet (gmac1) -- WORKING. Was "abandoned"; the real cause was a missing
 * PHY driver, not the SoC clock tree.
 *
 * The PHY is a Maxio MAE0621A. This BSP ships no driver for it, so phylib bound
 * genphy, which never runs maxio_mae0621a_clk_init() -- the routine that flips
 * BIT(8) of page 0xd92 reg 0x02 and makes the MAE0621A source the 125 MHz RGMII
 * clock. The PHY therefore never started: MDIO read 0xffff and the GMAC DMA reset
 * hung. Guangdong Hpraise supplied drivers/net/phy/maxio.c (v1.8.1.4); the recipe
 * installs it and builds it in via CONFIG_MAXIO_PHY=y (ethernet-maxio.cfg).
 *
 * The earlier clock_in_out="output" / clk_mac1_out experiment was chasing this
 * from the wrong end. Schematic SZ3568-V12-162 sheet 23 settles it: Y4 is a
 * 25 MHz SMD3225 crystal on PHY0_XTALIN/XTALOUT, and R168 22R carries
 * PHY0_CLKOUT125 -> GMAC1_MCLKINOUT marked "MAC <- PHY". The PHY is the clock
 * SOURCE, so clock_in_out = "input" in rk3568-sz3568-v10.dtsi is correct.
 *
 * PHY ADDRESS = 0. Verified on the target with `mdio stmmac-1`, which walks the
 * bus over netlink and so bypasses phylib:
 *
 *     DEV      PHY-ID  LINK
 *     0x00  0x7b744411  up
 *
 * 0x7b744411 is exactly the MAE0621A-Q2C id in maxio.c. Sheet 23's "PHY Address
 * 1 (default)" table lists the strap OPTIONS; this build omits the R182 pull-up
 * on PHYAD0, so it straps to 0 and the vendor's original reg = <0x0> was right.
 *
 * Two traps worth recording:
 *   - The vendor dtsi declares FOUR nodes all named "phy@0" under &mdio1
 *     (qsgmii_phy0, rmii_phy1, rgmii_phy1 + phy@0). dtc silently MERGES
 *     same-named nodes, so all three labels resolve to one node. Replaced here
 *     with a single explicit node.
 *   - Leaving &mdio1 childless does NOT enable bus scanning:
 *     of_mdiobus_register() sets mdio->phy_mask = ~0 to suppress auto-probing and
 *     registers only DT children, so no children means no PHY at all. An explicit
 *     node is mandatory.
 *
 * Other schematic checks that came back clean: GMAC1_RSTN_L is GPIO3_A1 ball AB8
 * (matches snps,reset-gpio in the dtsi), every GMAC1 signal is an _M0 function
 * (matches the gmac1m0_* pinctrl), and VCC3V3_PHY0 is SYS+3V3 through 0R R193 so
 * the rail is unconditionally on.
 *
 * gmac0's phy-handle is deleted only so phy@0 can be removed without dangling
 * that phandle; gmac0 is status = "disabled" (QSGMII, not fitted on this board).
 * With gmac0 off, gmac1 enumerates as eth0 -- not eth1.
 * ========================================================================== */
&gmac0 {
	/delete-property/ phy-handle;
};

&mdio1 {
	/delete-node/ phy@0;
	/delete-node/ phy@1;
	/delete-node/ phy@2;
	/delete-node/ phy@3;
};

/* The PHY ID is HARD-CODED here on purpose -- do not "simplify" this back to a
 * bare ethernet-phy-ieee802.3-c22.
 *
 * With the generic compatible, phylib probes the ID itself, and on this board the
 * FIRST MDIO read after the PHY reset comes back 0xffff because the MAE0621A is
 * not out of reset yet. Register 3 then reads correctly, so phylib computed:
 *
 *     /sys/bus/mdio_bus/devices/stmmac-1:00/phy_id = 0xffff4411
 *                                                     ^^^^ reg 2 lost
 *
 * against the driver's 0x7b744411 / mask 0x7fffffff:
 *     (0xffff4411 ^ 0x7b744411) & 0x7fffffff = 0x048b0000  -> no match
 * so it fell back to "Generic PHY". genphy then hangs in genphy_soft_reset()
 * polling BMCR_RESET on this paged part, which surfaced as
 *     ip link set eth0 up -> RTNETLINK answers: Connection timed out
 *
 * (Re-reading the same registers later works fine -- `mdio stmmac-1 phy 0 raw 2`
 * returns 0x7b74 and `raw 3` returns 0x4411 -- confirming it is purely a
 * reset-timing race on the first read, not a wiring or address problem.)
 *
 * "ethernet-phy-idAAAA.BBBB" makes of_mdiobus_register() construct the phy_device
 * with that exact id and skip the probe, so the MAE0621A driver binds
 * deterministically no matter how slow the PHY is to wake. AAAA = register 2,
 * BBBB = register 3. The c22 string is kept as the documented fallback. */
&mdio1 {
	sz3568_gmac1_phy: ethernet-phy@0 {
		compatible = "ethernet-phy-id7b74.4411",
			     "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
};

&gmac1 {
	phy-handle = <&sz3568_gmac1_phy>;
};

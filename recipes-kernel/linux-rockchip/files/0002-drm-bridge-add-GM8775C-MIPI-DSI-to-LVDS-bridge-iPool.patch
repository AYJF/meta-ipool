index 2ce94cabb490..0f5563f50029 100644
--- a/drivers/gpu/drm/bridge/Kconfig
+++ b/drivers/gpu/drm/bridge/Kconfig
@@ -383,6 +383,17 @@ config DRM_TOSHIBA_TC358775
 	help
 	  Toshiba TC358775 DSI/LVDS bridge chip driver.
 
+config DRM_GM8775C
+	tristate "GM8775C MIPI-DSI to LVDS bridge"
